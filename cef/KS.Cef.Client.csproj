<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>KS.Cef.Client</AssemblyName>
    <Version>1.0.3</Version>
    <Product>KS Client CEF Beta 1.0.3</Product>
    <ApplicationIcon>assets\ks-logo.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CefSharp.WinForms.NETCore" Version="154.0.340" />
    <Content Include="overlay\*.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
